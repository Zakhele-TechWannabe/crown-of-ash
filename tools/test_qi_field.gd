extends SceneTree
const Field = preload("res://src/qi_field.gd")
const Save = preload("res://src/world_save.gd")

class Account extends RefCounted:
	var will := 100.0
	var society_ref: WeakRef
	var notes: Array = []
	func note(_person: int, _kind: String, text: String, _day: int = -1) -> void: notes.append({"day":_day,"text":text})

func _initialize() -> void:
	var memory_before := OS.get_static_memory_usage()
	var a := Field.new()
	a.seed(0, "fixture")
	var tracked_memory := OS.get_static_memory_usage() - memory_before
	var b := Field.new()
	b.seed(0, "fixture")
	assert(Field.proportional(4000000000000000000,4000000000000000000,8000000000000000000) == PackedInt64Array([2000000000000000000,0]))
	assert(a.graph() == b.graph(), "Seeded graph")
	assert(a.save_state() == b.save_state(), "Seeded inventories")
	assert(a.save_state().cells.is_empty(), "Regenerable genesis inventories are omitted")
	assert(a.graph().nodes.size() == 52)
	for amount: int in a._mass: assert(amount >= 0)
	assert(a.ledger.residual == 0)
	for source: Dictionary in a.ledger.sources:
		assert(int(source.opening) + int(source.regeneration) - int(source.emitted) - int(source.get("tapped",0)) == int(source.closing))
	print("QI tracked allocation delta %d bytes (%.3f MiB)" % [tracked_memory,tracked_memory / 1048576.0])
	print("QI memory %d bytes (%.3f MiB), generation %.3f ms" % [a.memory_bytes(),a.memory_bytes() / 1048576.0,a.generation_usec / 1000.0])
	for name: String in a.landmarks: print("QI %s: %s" % [name,a.describe(a.landmarks[name])])
	assert(a.cell_at(Vector2(15,15)) == 0)
	assert(a.cell_at(Vector2(16,16)) == 361)
	var position: Vector2 = a.landmarks.Village
	var demand := PackedInt64Array([999999999999999,999999999999999,999999999999999,999999999999999,999999999999999])
	for id: String in ["alpha","beta","gamma"]: a.request(id,position,demand,2)
	for id: String in ["gamma","alpha","beta"]: b.request(id,position,demand,2)
	a.advance(1)
	b.advance(1)
	assert(a.allocations == b.allocations, "Order independent largest remainders")
	for e in 5:
		assert(absi(a.allocations.alpha[e] - a.allocations.beta[e]) <= 1)
		assert(a.sample(position).elements[e] == 0)
	assert(a.ledger.withdrawals > 0)
	check_ledger(a)
	assert(a.save_state() == b.save_state())
	var ordinary_started := Time.get_ticks_usec()
	for d in range(2,411):
		a.advance(d)
		check_ledger(a)
	print("QI ordinary replay %.3f ms/day" % [(Time.get_ticks_usec() - ordinary_started) / 409000.0])
	for span in [6,37,365,410]: b.advance(span)
	assert(a.save_state() == b.save_state(), "Daily and irregular partitions")
	var before := a.save_state()
	a.advance(409)
	assert(a.save_state() == before, "No duplicate or backward stepping")
	var c := Field.new()
	Save.restore(c, Save.capture(a))
	assert(c.save_state() == a.save_state(), "Sparse save round trip")
	c.advance(450)
	a.advance(450)
	assert(c.save_state() == a.save_state(), "Saved remainders")
	c.load_state({}, 200000)
	assert(c.day == 200000, "Legacy repair starts at save date")
	assert(c.graph().nodes.size() == 52)
	var state := b.save_state()
	state.reserves[1] = 0
	state.integrity[1] = 0
	c.load_state(state,410)
	c.damage_source(0,1000)
	assert(c.graph().nodes[0].integrity == 1000, "Heavenly source indestructible")
	c.advance(411)
	assert(c.graph().nodes[1].reserve == 0, "Damaged source cannot regenerate")
	check_ledger(c)
	var emergency := Field.new()
	emergency.seed()
	emergency.request("spring drain",emergency.landmarks.Sect,demand,0)
	emergency.advance(1)
	emergency.set_emergency_output(1,true)
	emergency.advance(2)
	assert(emergency.ledger.sources[1].emitted > 320000)
	assert(emergency.ledger.sources[1].emitted <= 640000)
	assert(emergency.ledger.sources[1].closing < emergency.ledger.sources[1].opening)
	check_ledger(emergency)
	var severed := Field.new()
	severed.seed()
	severed.damage_edge(1,1000)
	severed.advance(1)
	assert(severed.ledger.sources[1].emitted == 0, "Severed upstream edge blocks downstream delivery")
	var narrowed := Field.new()
	narrowed.seed()
	narrowed.damage_edge(1,750)
	narrowed.advance(1)
	assert(narrowed.ledger.sources[1].emitted <= 160000, "Upstream and downstream outlets share trunk capacity")
	var priority := Field.new()
	priority.seed()
	priority.request("low",position,demand,10)
	priority.request("high",position,demand,0)
	priority.advance(1)
	assert(priority.allocations.low == PackedInt64Array([0,0,0,0,0]))
	assert(priority.allocations.high[0] > 0)
	priority.load_state({},12345)
	assert(priority.allocations.is_empty(), "Legacy repair clears old receipts")
	var emptied := Field.new()
	emptied.seed()
	emptied.request("full palace withdrawal",emptied.landmarks.Palace,demand,0)
	emptied.advance(1)
	var empty_sample: Dictionary = emptied.sample(emptied.landmarks.Palace)
	assert(empty_sample.quantity == 0)
	assert(empty_sample.purity == 0 and empty_sample.polarity == 0)
	for seed_index in 10:
		var field := Field.new()
		field.seed(0,"superiority:%d" % seed_index)
		var palace: Dictionary = field.sample(field.landmarks.Palace)
		assert(palace.density > field.sample(field.landmarks.Sect).density)
		assert(palace.density > field.sample(field.landmarks.Village).density)
		assert(palace.source == "Heavenly Origin")
		assert(palace.purity > field.sample(field.landmarks.Village).purity)
		assert(field.ledger.source_output > 0)
		field.damage_source(1,1000)
		field.advance(365 if seed_index == 0 else 2)
		for cell in field._active:
			var s: Dictionary = field.sample(field.position_of(cell))
			var sum := 0
			for element in s.elements:
				assert(element >= 0)
				sum += element
			assert(sum == s.quantity)
		check_ledger(field)
	var cycle_daily := Field.new()
	var cycle_jump := Field.new()
	cycle_daily.seed()
	cycle_jump.seed()
	# Source-free equilibrium is a known exact cycle; this checks the jump optimisation.
	for field: RefCounted in [cycle_daily,cycle_jump]:
		field._config.dispersion_numerator = 0
		for node: Dictionary in field._nodes: node.integrity = 0
	var cycle_started := Time.get_ticks_usec()
	for d in 1000: cycle_daily.advance(d + 1)
	print("QI daily reference %.3f ms/day" % [(Time.get_ticks_usec() - cycle_started) / 1000000.0])
	cycle_jump.advance(1000)
	assert(cycle_daily.save_state() == cycle_jump.save_state(), "Exact witnessed-cycle jumps")
	assert(cycle_daily.ledger == cycle_jump.ledger)
	check_decrees()
	print("SKIP compartments: no chambers or carved volumes in Stage 1")
	print("PASS qi field: generation, inventories, ledger, allocation, spans, saves, sources")
	quit()

func check_ledger(field: RefCounted) -> void:
	var l: Dictionary = field.ledger
	assert(l.residual == 0)
	for residual: int in l.element_residuals: assert(residual == 0)
	var withdrawn := 0
	for amount: int in l.withdrawal_elements: withdrawn += amount
	assert(withdrawn == int(l.withdrawals))
	for source: Dictionary in l.sources:
		assert(int(source.opening) + int(source.regeneration) - int(source.emitted) - int(source.get("tapped",0)) == int(source.closing))
		for e in 5:
			assert(source.opening_elements[e] + source.regenerated_elements[e] - source.emitted_elements[e] - source.tapped_elements[e] == source.closing_elements[e])
	assert(int(l.opening_reserves) + int(l.regeneration) - int(l.source_output) - int(l.tap_withdrawals) == int(l.closing_reserves))
	assert(int(l.opening_field) + int(l.source_output) + int(l.background_recovery) - int(l.withdrawals) + int(l.tap_withdrawals) - int(l.dispersion) == int(l.closing_field))

func check_decrees() -> void:
	var a := Field.new()
	a.seed()
	for node: Dictionary in a.graph().nodes: assert(node.reserve == node.capacity,"Fresh reserves full")
	var account := Account.new()
	account.society_ref = weakref(account)
	a.heaven = account
	a.set_decree(1,0.0)
	var at: Vector2 = a.position_of(a.graph().outlets[1].cell)
	a.request("formation tap",at,PackedInt64Array([100000,100000,100000,100000,100000]),0,true)
	a.advance(1)
	assert(a.ledger.sources[1].emitted == 0 and a.ledger.sources[1].tapped == 500000)
	assert(a.thefts().size() == 1 and a.thefts()[0].consumer_id == "formation tap")
	check_ledger(a)
	var reserve: int = a.graph().nodes[1].reserve
	a.advance(2)
	assert(a.ledger.sources[1].emitted == 0,"Sealed ambient emission")
	assert(a.graph().nodes[1].reserve > reserve,"Sealed reserve regenerates")
	check_ledger(a)
	var b := Field.new()
	b.load_state(a.save_state(),a.day)
	var second := Account.new()
	second.society_ref = weakref(second)
	b.heaven = second
	for d in range(3,366): a.advance(d)
	b.advance(365)
	assert(account.will == 96.0 and second.will == 96.0)
	assert(a.save_state() == b.save_state(),"Decrees span invariant")
	account.will = 0.0
	second.will = 0.0
	for d in range(366,731): a.advance(d)
	b.advance(730)
	assert(a.save_state() == b.save_state() and account.notes == second.notes,"Unpaid lapse spans and dated notes")
	assert(a.decrees().is_empty() and not account.notes.is_empty(),"Unpaid decree lapses with story")
	var open := Field.new()
	var throttled := Field.new()
	open.seed()
	throttled.seed()
	throttled.set_decree(0,0.5)
	open.advance(1)
	throttled.advance(1)
	assert(throttled.ledger.sources[0].emitted <= open.ledger.sources[0].emitted / 2 + 5,"Throttle scales actual emission")
	check_ledger(throttled)
	var tap_a := Field.new()
	var tap_b := Field.new()
	for f: RefCounted in [tap_a,tap_b]:
		f.seed()
		f.set_decree(1,0.0)
	for id: String in ["a","b"]: tap_a.request(id,at,PackedInt64Array([999999999,999999999,999999999,999999999,999999999]),0,true)
	for id: String in ["b","a"]: tap_b.request(id,at,PackedInt64Array([999999999,999999999,999999999,999999999,999999999]),0,true)
	tap_a.advance(1)
	tap_b.advance(1)
	assert(tap_a.save_state() == tap_b.save_state(),"Competing taps ignore insertion order")
	check_ledger(tap_a)
	for d in range(2,132):
		tap_a.request("miner",at,PackedInt64Array([1,1,1,1,1]),0,true)
		tap_a.advance(d)
	assert(tap_a.thefts().size() == 128 and tap_a.thefts()[0].day == 4,"Bounded theft history")
	assert(tap_a.thefts()[-1].day == 131)
	tap_b.load_state(tap_a.save_state(),tap_a.day)
	assert(tap_b.thefts() == tap_a.thefts(),"Thefts saved")
	var region := Field.new()
	region.seed()
	var pos: Vector2 = region.landmarks.Village
	region.set_decree({"id":"village","cells":[region.cell_at(pos)]},0.25)
	region.request("living",pos,PackedInt64Array([400,400,400,400,400]),0)
	region.advance(1)
	assert(region.allocations.living == PackedInt64Array([100,100,100,100,100]))
	check_ledger(region)
	assert(region.decrees()[0].upkeep == 1.5)
	print("PASS qi decrees: reserves, taps, regions, yearly Will, lapse, save and spans")
