extends SceneTree
func _initialize() -> void:
	var p := preload("res://src/population.gd").new()
	var job := p.register_job("chores", ["chores"])
	for i in 70: p.add_person("Test %d" % i, 20, job)
	var r: RefCounted = p.society.ties
	r.event(0, 1, "saved_life", 1)
	assert(r.opinion[r.find(0, 1)] == 60)
	assert(r.find(1, 0) == -1, "Ties must be asymmetric")
	for i in range(2, 70): r.tie(0, i)
	assert(r.count[0] == 48)
	assert(r.find(0, 1) >= 0, "Evict weak ties before important bonds")
	for i in 5: r.event(1, 0, "theft", i)
	var e: int = r.find(1, 0)
	assert(r.opinion[e] == -100 and r.memory_rows(e).size() == 3)
	assert(r.has_grudge(e))
	var before: float = r.memory_rows(e)[0].weight
	r.drift_person(1, p)
	assert(absf(r.memory_rows(e)[0].weight) < absf(before))
	for i in 5: r.event(1, 0, "apology", 8)
	assert(not r.has_grudge(e))
	var packed := preload("res://src/relationships.gd").new()
	for i in 70: packed.add_person()
	for event_day in 1000: packed.event(0, event_day % 69 + 1, "saved_life", event_day)
	assert(packed.count[0] == 48 and packed.memory_weight.size() <= 48 * 3, "Evicted memories reuse packed slots")
	packed.event(1, 2, "betrayal", 1001)
	var inherited: int = packed.tie(3, 2)
	packed.inherit_grudge(packed.find(1, 2), inherited, .3)
	assert(is_equal_approx(packed.grudge_intensity(inherited), 24))
	p.job[0] = p.register_job("field hand", ["fields"])
	p.job[1] = p.register_job("farmer and smith", ["fields", "smith"])
	assert(p.shared_work(0, 1), "Different job titles can share a morning field shift")
	p.job[1] = p.register_job("fisher", ["fishery"])
	assert(not p.shared_work(0, 1))
	print("PASS relationships: asymmetry, cap, eviction, memories, drift, grudges and resolution")
	quit()
